<script src="assets/js/ecbi/api/pays.js"></script>
<script>
    /* ===== State ===== */
    let currentStep = 0;
    const totalSteps  = 3;
    const validatedSteps = new Set();

    /* ===== DOM refs ===== */
    const stepItems   = document.querySelectorAll('.step-item');
    const connectors  = [document.getElementById('conn0'), document.getElementById('conn1')];
    const panels      = document.querySelectorAll('.step-panel');
    const btnPrev     = document.getElementById('btnPrev');
    const btnNext     = document.getElementById('btnNext');
    const stepCounter = document.getElementById('stepCounter');
    const overlay     = document.getElementById('successOverlay');
    const container = document.getElementById('toastContainer');

    getPays(2, document.getElementById("pays"))
    document.getElementById("pays").addEventListener('change', ()=>{
        getVillesByPays(document.getElementById("pays").value, 2, document.getElementById("ville"))
        getVillesByPays(document.getElementById("pays").value, 2, document.getElementById("centre_impots"))
    })
    getCouleurApp(document.getElementById("couleur_barre_titre"), document.getElementById("lbl_couleur"))

    /* =====,  Validation Engine ===== */
    function validateStep(stepIndex) {
        const panel   = panels[stepIndex];
        const groups  = panel.querySelectorAll('.form-group[data-required]');
        let valid     = true;

        groups.forEach(g => {
            const input   = g.querySelector('input, select, textarea');
            if (!input) return;

            const val     = input.value.trim();
            const type    = g.dataset.type;
            const minLen  = g.dataset.minlength;
            const matchId = g.dataset.match;

            let error = false;

            // Required check
            if (!val) error = true;

            // Email check
            if (!error && type === 'email') {
                const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRe.test(val)) error = true;
            }

            // URL check
            if (!error && type === 'url') {
                try { new URL(val); } catch { error = true; }
            }

            // Min-length check
            if (!error && minLen && val.length < parseInt(minLen)) error = true;

            // Match check (password confirmation)
            if (!error && matchId) {
                const ref = document.getElementById(matchId);
                if (ref && val !== ref.value.trim()) error = true;
            }

            // Color pickers — always have a value, skip empty check; check only if primary is untouched (not needed really)
            if (input.type === 'color') error = false;

            g.classList.toggle('error', error);
            if (error) valid = false;
        });

        return valid;
    }

    /* ===== Clear Errors on Input ===== */
    document.querySelectorAll('.form-group[data-required] input, .form-group[data-required] select, .form-group[data-required] textarea').forEach(el => {
        const handler = () => {
            el.closest('.form-group').classList.remove('error');
        };
        el.addEventListener('input', handler);
        el.addEventListener('change', handler);
    });

    /* ===== Navigation ===== */
    function goToStep(next, direction) {
        const prev = currentStep;
        currentStep = next;

        // Update panels
        panels[prev].classList.remove('active');
        panels[prev].classList.add(direction === 'next' ? 'exit-left' : 'exit-right');

        panels[next].classList.remove('exit-left', 'exit-right');
        // Small delay so transition fires
        requestAnimationFrame(() => {
            panels[next].classList.add('active');
        });

        // Clean up previous panel after transition
        setTimeout(() => {
            panels[prev].classList.remove('exit-left', 'exit-right');
        }, 500);

        // Update stepper
        updateStepper();

        // Update buttons
        btnPrev.disabled = (next === 0);
        if (next === totalSteps - 1) {
            btnNext.innerHTML = '✅ Valider';
            btnNext.className = 'btn-submit';
        } else {
            btnNext.innerHTML = 'Suivant →';
            btnNext.className = 'btn-next';
        }

        stepCounter.textContent = `Étape ${next + 1} sur ${totalSteps}`;
    }

    function updateStepper() {
        stepItems.forEach((item, i) => {
            item.classList.remove('active', 'validated');
            if (i === currentStep) item.classList.add('active');
            else if (validatedSteps.has(i)) item.classList.add('validated');
        });

        connectors.forEach((c, i) => {
            c.classList.remove('done', 'all-done');
            if (validatedSteps.has(i) && validatedSteps.has(i + 1)) c.classList.add('all-done');
            else if (validatedSteps.has(i)) c.classList.add('done');
        });
    }

    /* ===== Next / Prev Handlers ===== */
    btnNext.addEventListener('click', () => {
        if (!validateStep(currentStep)) {
            showToast(container, 'Veuillez corriger les erreurs avant de continuer', "error");
            return;
        }

        validatedSteps.add(currentStep);

        if (currentStep < totalSteps - 1) {
            goToStep(currentStep + 1, 'next');
            //showToast('Étape validée avec succès ✓', 'success');
            showToast(container, 'Étape validée avec succès ✓', "success");
        } else {
            // Final submit
            // showSuccess();
            sendRequest()
        }
    });

    btnPrev.addEventListener('click', () => {
        if (currentStep > 0) {
            goToStep(currentStep - 1, 'prev');
        }
    });

    /* ===== Toast ===== */
    /*function showToast(msg, type) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.textContent = (type === 'success' ? '✅ ' : '❌ ') + msg;
        container.appendChild(toast);

        setTimeout(() => {
            toast.style.animation = 'toastOut 0.3s ease forwards';
            setTimeout(() => toast.remove(), 300);
        }, 2500);
    }*/

    /* ===== Success Overlay ===== */
    function showSuccess() {
        overlay.classList.add('show');
        showToast(container, 'Personnalisation enregistrée avec succès !', "info");
        document.location.href = "{{ url('app_login') }}"
    }

    document.getElementById('btnClose').addEventListener('click', () => {
        overlay.classList.remove('show');
    });

    /* ===== Click on validated step to go back ===== */
    stepItems.forEach(item => {
        item.style.cursor = 'pointer';
        item.addEventListener('click', () => {
            const s = parseInt(item.dataset.step);
            if (validatedSteps.has(s) || s === currentStep) {
                goToStep(s, s < currentStep ? 'prev' : 'next');
            }
        });
    });

    /* ===== Init ===== */
    updateStepper();

    uploadImage(document.getElementById('logoUpload'), document.getElementById('logoPreview'));
    function uploadImage(button, image){
        button.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Vérification taille < 200Ko
                if (file.size > 1024 * 1024) {
                    showToast(container, "L'image dépasse 1Mo !", "warning");
                    e.target.value = "";
                    return;
                }
                // Aperçu
                const reader = new FileReader();
                reader.onload = function(ev) {
                    image.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }


