<script src="{{ asset('assets/js/ecbi/resources/utilitaires.js') }}"></script>
<script src="{{ asset('assets/js/ecbi/resources/showToast.js') }}"></script>
<script src="assets/js/ecbi/api/initialise.js"></script>
