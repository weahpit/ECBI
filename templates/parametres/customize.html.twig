<style>
    .nav-tabs {
        position: relative;
        margin-bottom: 5px;
        margin-top: 5px;
        background: transparent;
    }
    .nav-tabs .nav-link {
        color: #181818;
        font-weight: 600;
        border: none;
        position: relative;
        transition: color 0.3s ease;
    }
    .nav-tabs .nav-link.active {
        color: #0d6efd;
    }
    .tab-indicator {
        position: absolute;
        bottom: 0;
        height: 3px;
        background: linear-gradient(90deg, #0d6efd, #66b2ff);
        transition: all 0.3s ease;
        border-radius: 2px;
    }
</style>
<div class="container mt-2">
    <ul class="nav nav-tabs justify-content-center border-0 position-relative p-2" style="background: radial-gradient(#d7fad7, #e5fce5)" id="animatedTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link  active" id="tab-apercu" data-bs-toggle="tab" data-bs-target="#div_societe" type="button" role="tab">
                Information sur la société
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-details" data-bs-toggle="tab" data-bs-target="#div_customize" type="button" role="tab">
                Apparences
            </button>
        </li>
        <span class="tab-indicator"></span>
    </ul>

    <div class="tab-content p-2 shadow-sm rounded bg-white mt-1" id="animatedTabsContent">
        <div class="tab-pane fade show active" style="min-height: 400px;border: 1px lightgrey solid;background: radial-gradient(#fafafa,#f6f6f6)" id="div_societe" role="tabpanel">

        </div>
        <div class="tab-pane fade " style="min-height: 400px;border: 1px lightgrey solid;background: radial-gradient(#fafafa,#f6f6f6)" id="div_customize" role="tabpanel">

        </div>
    </div>
</div>
<script src="{{ asset('assets/js/ecbi/api/customize.js') }}"></script>
<script>
    let div_societe = document.querySelector("#div_societe")
    let div_customize = document.querySelector("#div_customize")
    getSocieteInfos(div_societe)
    getCustomInfos(div_customize)

    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('#animatedTabs .nav-link');
        const indicator = document.querySelector('.tab-indicator');

        function moveIndicator(tab) {
            const rect = tab.getBoundingClientRect();
            const parentRect = tab.parentElement.parentElement.getBoundingClientRect();
            indicator.style.width = rect.width + 'px';
            indicator.style.left = (rect.left - parentRect.left) + 'px';
        }

        tabs.forEach(tab => {
            if (tab.classList.contains('active')) moveIndicator(tab);
            tab.addEventListener('shown.bs.tab', () => moveIndicator(tab));
        });
    });
</script>
