<script>
    let div_body = document.querySelector('.contenu_references');
    let criteres = document.querySelector('#criteres');


    criteres.value = 0;
    resetForm(formClt)
    applyPhoneMask(tel)
    applyPhoneMask(mobile)
    applyInputHighlight("input")

    $("#criteres").on('change', function (){
        if(this.value === "0"){
            div_body.innerHTML = '<div class="text-center"><img class="mx-auto" src="{{ asset('assets/images/reference.png') }}" alt="references"></div>'
        } else if (this.value === "CLIENTS"){
            getClients(1, div_body)
        }  else if (this.value === "PRODUITS"){
            getProduits(1, div_body)
        }  else if (this.value === "QUALITES_PRODUITS"){
            getQualiteProduits(1, div_body)
        }  else if (this.value === "GRILLES"){
            getGrilles(1, div_body)
        }   else if (this.value === "SERVICES_ECBI"){
            getServiceEcbis(1, div_body)
        }    else if (this.value === "PAYS"){
            getPays(1, div_body)
        } else {
            div_body.innerHTML = '<div class="text-center"><img class="mx-auto" src="{{ asset('assets/images/reference.png') }}" alt="references"></div>'
        }
    })
</script>
