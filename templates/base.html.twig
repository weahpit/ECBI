{% set optionsApp = options_app %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">
    <style>
        body {
        {% if(optionsApp.getCustomize.typeFond == 'Couleur') %}
            background-color: {{ optionsApp.getCustomize.fondApplication }};
        {% else %}
            background-image: url("docs/modeles/{{ optionsApp.getCustomize.fondApplication }}");
        {% endif %}
            background-repeat: no-repeat;
            background-size: cover;
            font-family: {{ optionsApp.getCustomize.police|raw }};
        }
    </style>
</head>
<body>
{% block menu %}
    <!-- Menu horizontal -->
    <nav class="navbar-dark navbar-expand-sm" style="background: {{ optionsApp.getCustomize.barreTitreCouleur }}">
        <div class="container-fluid">
            <a class="navbar-brand h2" href="{{ path('app_tdb') }}" >
                {% if(optionsApp.getCustomize.typeIconeApplication == 'Image') %}
                    <img height="32px" src="docs/modeles/{{ optionsApp.getCustomize.iconeApplication }}" alt="">
                {% else %}
                    {{ optionsApp.getCustomize.iconeApplication }}
                {% endif %}
                {{ optionsApp.getCustomize.prefixApplication }}
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#">🏠 Accueil</a></li>

                    <!-- Menu Commandes avec sous-menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="commandesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            📦 Commandes
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="commandesDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_proforma') }}">➕ Nouvelle Proforma</a></li>
                            <li><a class="dropdown-item" href="{{ path('validation_proforma') }}">➕ Validation des proformas</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_commandes') }}">➕ Nouvelle commande</a></li>
                            <li><a class="dropdown-item" href="{{ path('liste_commandes') }}">📋 Liste des commandes</a></li>
                        </ul>
                    </li>
                    <!-- Production avec sous-menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="productionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            🏭 Production
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="productionDropdown">
                            <li><a class="dropdown-item" href="#">📌 Planification</a></li>
                            <li><a class="dropdown-item" href="#">⚙️ Suivi des tâches</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">🚚 Livraisons</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">📊 Stocks</a></li>
                            <li><a class="dropdown-item" href="#">📑 Rapports</a></li>
                        </ul>
                    </li>

                    <li class="nav-item"><a class="nav-link" href="{{ path('app_parametres') }}">⚙️ Paramètres</a></li>
                </ul>
            </div>
        </div>
    </nav>

{% endblock %}
<!-- Contenu du dashboard -->
<nav class="navbar navbar-light p-0" style="border-bottom: 2px solid #dbb001;">

    <h2 class="text-secondary p-1 ps-4 w-75">
            {% block page_titre %}

            {% endblock %}
        </h2>
        {% if (app.user) %}

            <div class="notifs_div" style="width: 40px;">

            </div>

            <div class="btn-group m-2 d-flex" style="border: 1px solid #c9a202;">
                <button class="btn btn-sm fw-bold" type="button" style="background-color: #ccffcc">
                    {{ app.user.nom }} {{ app.user.prenoms }}
                </button>
                <button type="button" class="btn btn-sm dropdown-toggle dropdown-toggle-split"  style="background-color: #ccffcc" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">{{ app.user.nom }} {{ app.user.prenoms }}</span>
                </button>
                <ul class="dropdown-menu">
                    <li><a class="btn fw-bold" href="{{ path('app_logout') }}"> <i class="fa fa-power-off text-danger me-2 ms-1"></i>déconnection</a></li>
                </ul>
            </div>
        {% endif %}

</nav>
<div class="dashboard container-fluid panel" id="panel" style="/*min-height: 50em;*/">
        {% block body %}

        {% endblock %}
    </div>
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('assets/js/external/jquery.js') }}"></script>
<script src="{{ asset('assets/js/external/sweetalert/sweetalert.min.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="{{ asset('assets/js/ecbi/resources/utilitaires.js') }}"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.min.js"></script>

<script>
    toggleDiv()
    listeNotifications()

    function toggleDiv() {
        const panel = document.getElementById("panel");
        panel.classList.toggle("open");
    }

    setInterval(()=>{
        listeNotifications()
    }, 10000)

    function listeNotifications(){
        let notifs_div = document.querySelector(".notifs_div")
        let ul_contenu = ''
        $.ajax({
            url : 'getCurrentNotifs',
            type : 'POST',
            success : function(response){
                let rep = JSON.parse(response);
                if (rep.nbNotifs > 0){


                    notifs_div.innerHTML = `
                        <div class="dropdown" role="group">
                                        <button id="notifBtn" class="btn btn-light position-relative mt-2 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-bell"></i>
                                            <span id="notifCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                    ${rep.nbNotifs}
                                            </span>
                                        </button>
                                        <ul class="dropdown-menu" id="notifList"></ul>
                        </div>
                    `
                    for (var i=0; i<rep.data.length;i++){
                        ul_contenu += '<li><a class="dropdown-item a_notif" target="_blank" href="'+ rep.data[i].lien +'" id ="' + rep.data[i].id +'"><span class="fw-bold text-dark">' + rep.data[i].title + '</span><br>'
                        if (rep.data[i].msg.length > 50){
                            let value_slice = rep.data[i].msg;
                            ul_contenu += '<small class="text-secondary fw-light" style="font-size: 11px;">' + value_slice.slice(0, 50) + '...</small></li>'
                        } else {
                            ul_contenu += '<small class="text-secondary fw-light" style="font-size: 11px;">' + rep.data[i].msg + '</small></li>'
                        }
                        ul_contenu += '</a><hr>'
                    }
                    document.querySelector("#notifList").innerHTML = ul_contenu;
                }
            }
        })
    }

    $("body").on("click", ".a_notif", function (){
        $.ajax({
            url : 'setLu/' + this.id,
            type : 'POST',
            success : function(response){

            }
        });
    });

</script>
</body>
</html>
